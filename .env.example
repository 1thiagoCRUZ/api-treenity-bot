# Porta em que a API sobe
PORT=3000

# Ambiente: development | production (controla o cookie "secure" do refresh token)
NODE_ENV=development

# Origens que podem chamar a API com cookies (refresh token). Aceita uma lista
# separada por vírgula (ex: demo embutida + Live Server). Em produção, use o(s)
# domínio(s) real(is) do frontend/painel — nunca "*".
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# Connection string do Postgres (painel do projeto Supabase > Project Settings >
# Database > Connect > "Session pooler"). Toda a leitura/escrita da API passa
# pelo Drizzle usando essa conexão direta — não há mais dependência do
# @supabase/supabase-js nem das chaves SUPABASE_URL/SUPABASE_KEY.
DATABASE_URL=postgresql://postgres.xxxxxxxx:sua_senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave usada para criptografar/descriptografar o conteúdo das mensagens de chat
# (qualquer string longa e aleatória — troque para um valor único e secreto)
ENCRYPTION_KEY=troque_por_uma_string_longa_e_aleatoria

# Segredo usado para assinar os access tokens (JWT). Gere um valor aleatório,
# ex: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque_por_um_segredo_longo_e_aleatorio

# OPCIONAL — só defina se algum backend externo de confiança (ex: o backend do
# deskcomm) for chamar POST /api/auth/sso para obter token em nome de um usuário
# já autenticado lá. Sem essa variável, a rota fica desativada (501), o resto
# da API funciona normalmente. NUNCA deve aparecer em código de frontend/navegador.
# Mesmo formato do JWT_ACCESS_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SSO_SHARED_SECRET=troque_por_outro_segredo_longo_e_aleatorio

# OPCIONAL — só defina se o n8n do bot de atendimento for chamar
# POST /api/atendimentos/sinalizar (ver n8n/README.md). Sem essa variável, a
# rota fica desativada (501). NUNCA deve aparecer em código de frontend/navegador.
# Mesmo formato do JWT_ACCESS_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
N8N_SHARED_SECRET=troque_por_outro_segredo_longo_e_aleatorio

# OPCIONAL — só defina se algum agendador externo (ex: o workflow agendado do
# GitHub Actions em .github/workflows/metrics-cron.yml) for chamar
# POST /api/dashboard/atualizar-agendado. Sem essa variável, a rota fica
# desativada (501). NUNCA deve aparecer em código de frontend/navegador.
# Mesmo formato do JWT_ACCESS_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRON_SHARED_SECRET=troque_por_outro_segredo_longo_e_aleatorio
