# Dependências
node_modules/

# Variáveis de ambiente e segredos
.env
.env.*
# ...exceto o template sem segredos reais, que deve ficar versionado
!.env.example

# Exports do n8n contêm tokens/credenciais em texto puro (Facebook, Azure,
# Frenet) embutidos nos nós — nunca versionar. Ver n8n/README.md.
n8n/*.json

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema Operacional
.DS_Store
Thumbs.db

